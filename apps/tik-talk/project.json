{
  "name": "tik-talk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "type": "component",
      "style": "scss",
      "skipTests": true
    },
    "@schematics/angular:directive": {
      "type": "directive",
      "skipTests": true
    },
    "@schematics/angular:service": {
      "type": "service",
      "skipTests": true
    },
    "@schematics/angular:guard": {
      "typeSeparator": ".",
      "skipTests": true
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": ".",
      "skipTests": true
    },
    "@schematics/angular:module": {
      "typeSeparator": ".",
      "skipTests": true
    },
    "@schematics/angular:pipe": {
      "typeSeparator": ".",
      "skipTests": true
    },
    "@schematics/angular:resolver": {
      "typeSeparator": ".",
      "skipTests": true
    }
  },
  "sourceRoot": "apps/tik-talk/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "apps/tik-talk/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/tik-talk/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": ["apps/tik-talk/src/styles.scss"],
        "outputPath": "dist/tik-talk"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "tik-talk:build:production"
        },
        "development": {
          "buildTarget": "tik-talk:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular/build:unit-test"
    }
  }
}
